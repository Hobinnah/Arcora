<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Clear any inherited/global package sources (including the private Ceridian/Dayforce
    Azure Artifacts feed) so restores in this repository only use the public nuget.org feed.
    This prevents 401 stalls against unreachable private feeds during build/restore/EF commands.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <!-- Disable NuGet vulnerability auditing which also reaches out over the network. -->
  <config>
    <add key="NuGetAudit" value="false" />
  </config>
</configuration>
