{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "SeedData": {
    "ForceReseed": false
  },
  "ConnectionStrings": {
    "DefaultAppConnection": "akv:database-connection" //"Server=(localdb)\\MSSQLLocalDB;Database=ArcoraDb_Dev;Trusted_Connection=True;MultipleActiveResultSets=True;TrustServerCertificate=True"
  },
  "IdentityVerification": {
    "DefaultProvider": "PERSONA"
  },
  "Persona": {
    "BaseUrl": "https://withpersona.com/api/v1/",
    "ApiKey": "",
    "TemplateId": "",
    "HostedVerificationUrlTemplate": "https://withpersona.com/verify?inquiry-id={inquiryId}",
    "WebhookSecret": ""
  },
  "Onfido": {
    "BaseUrl": "https://api.onfido.com/v3.6/",
    "ApiKey": "",
    "WorkflowRunId": "",
    "HostedVerificationUrlTemplate": "",
    "WebhookSecret": ""
  },
  "Twilio": {
    "Verify": {
      "AccountSid": "",
      "AuthToken": "",
      "ServiceSid": "",
      "Channel": "sms"
    }
  },
  "PhoneVerification": {
    "Provider": "INFOBIP",
    "InfobipCodeLength": 5,
    "InfobipCodeExpiryMinutes": 5
  },
  "Infobip": {
    "ApiKey": "",
    "BaseUrl": ""
  },
  "Signwell": {
    "AutoSendEnabled": true,
    "BaseUrl": "https://www.signwell.com/api/v1"
  },
  "Stripe": {
    "ThrowOnApiVersionMismatch": "false"
  },
  "Azure": {
    "SignalR": {
      "ConnectionString": ""
    },
    "BlobStorage": {
      "ConnectionString": "UseDevelopmentStorage=true",
      "ImagesContainer": "images",
      "DocumentsContainer": "documents",
      "FilesContainer": "files",
      "SasExpiryMinutes": 60
    },
    "KeyVault": {
      "Enabled": true,
      "AllowEnvironmentFallback": true,
      "VaultUri": "https://apparcorakeyvault.vault.azure.net/"
    }
  }
}
