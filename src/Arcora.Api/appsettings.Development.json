{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "SeedData": {
    "ForceReseed": false
  },
  "Signwell": {
    "AutoSendEnabled": true
  },
  "Azure": {
    "BlobStorage": {
      "ConnectionString": "UseDevelopmentStorage=true",
      "ImagesContainer": "images",
      "DocumentsContainer": "documents",
      "FilesContainer": "files",
      "SasExpiryMinutes": 60
    }
  }
}
